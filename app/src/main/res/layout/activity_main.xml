<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Preview-ul și grila stau deasupra barei de prag, ca rândul de referință să rămână vizibil -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ro.awebdesign.brickpilot.GridOverlayView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Textul se micșorează singur ca să încapă pe un rând pe orice telefon -->
        <Button
            android:id="@+id/btnConnect"
            android:layout_width="170dp"
            android:layout_height="52dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:backgroundTint="@color/btn_connect_tint"
            android:maxLines="1"
            android:text="@string/btn_connect"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnMode"
            android:layout_width="170dp"
            android:layout_height="52dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="8dp"
            android:layout_marginTop="64dp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:backgroundTint="#FF6A1B9A"
            android:maxLines="1"
            android:text="@string/mode_obstacles"
            android:textColor="@android:color/white" />

        <!-- Statusul stă între coloanele laterale, ca să nu acopere butoanele sau bifele.
             Pe verticală MainActivity îl mută sub butoane, iar STOP devine cât START -->
        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginStart="186dp"
            android:layout_marginEnd="186dp"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:background="#99000000"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="#99000000"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <CheckBox
                android:id="@+id/chkInvA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/invert_a"
                android:textColor="@android:color/white" />

            <CheckBox
                android:id="@+id/chkInvB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/invert_b"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStart"
            android:layout_width="170dp"
            android:layout_height="120dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:backgroundTint="@color/btn_start_tint"
            android:enabled="false"
            android:text="@string/btn_start"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- STOP ocupă aproape toată coloana din dreapta, ca să fie ușor de nimerit -->
        <Button
            android:id="@+id/btnStop"
            android:layout_width="170dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginTop="112dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/btn_stop_tint"
            android:enabled="false"
            android:text="@string/btn_stop"
            android:textColor="@android:color/white"
            android:textSize="40sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Bara de jos: pe orizontală un singur rând, pe verticală câte un slider pe rând -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="24dp">

        <!-- Buton mic în colț pentru schimbarea tipului de mașină -->
        <TextView
            android:id="@+id/btnVehicle"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="16dp"
            android:background="#FF37474F"
            android:clickable="true"
            android:contentDescription="@string/vehicle_btn_desc"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="@string/vehicle_btn_1"
            android:textColor="@android:color/white"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/thresholdGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/thresholdLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="110dp"
                android:textColor="@android:color/white" />

            <SeekBar
                android:id="@+id/threshold"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:max="40"
                android:min="5" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/speedGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/speedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:minWidth="120dp"
                android:textColor="@android:color/white" />

            <SeekBar
                android:id="@+id/speed"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:max="200"
                android:min="40" />
        </LinearLayout>

        <!-- Doar la tipul 2: cât de tare virează direcția pentru aceeași comandă -->
        <LinearLayout
            android:id="@+id/steerGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/steerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:minWidth="100dp"
                android:textColor="@android:color/white" />

            <SeekBar
                android:id="@+id/steer"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:max="400"
                android:min="100" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

    <!-- Alegerea tipului de mașină: la prima pornire și din butonul mic din colț -->
    <LinearLayout
        android:id="@+id/vehiclePicker"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2101418"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vehicle_title"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Pe orizontală imaginile stau una lângă alta, pe verticală una sub alta -->
        <LinearLayout
            android:id="@+id/vehicleCards"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardType1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@android:color/white"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/vehicle_type1"
                    android:scaleType="fitCenter"
                    android:src="@drawable/vehicle_type1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/vehicle_type1"
                    android:textColor="#FF101418"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardType2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@android:color/white"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/vehicle_type2"
                    android:scaleType="fitCenter"
                    android:src="@drawable/vehicle_type2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/vehicle_type2"
                    android:textColor="#FF101418"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
